{
  "name": "the-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "THE WORKSHOP — one room by HrM that hangs itself around your attention.",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:browser": "node tests/browser-hotfix-smoke.mjs",
    "test:instrument": "node tests/browser-instrument-smoke.mjs",
    "prepare:vendor": "node scripts/prepare-vendor.mjs",
    "test:all": "npm run prepare:vendor && npm test && npm run test:gallery && npm run test:browser && npm run test:instrument",
    "serve": "node scripts/serve.mjs",
    "test:gallery": "node tests/browser-gallery-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "playwright": "1.47.0"
  }
}
