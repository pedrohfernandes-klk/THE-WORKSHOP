{"id":"tortoise","legacy":true,"enabledByDefault":true,"model":{"id":"tortoise","head":"tortoise","shape":[1,1,1.3],"colors":{"skin":"#829052","jacket":"#9e824d","trousers":"#41404a","shirt":"#fff3d6","hair":"#342b28","accent":"#ffcd75"}},"lines":{"ignored":["Estou aqui. Sem apresentação.","A conversa ficou em espera."],"slap1":["Já levaste na boca!","A mão vinha sem assunto?"],"slap2":["Levaste na boca, boneco!","Outra vez? Faltou pontuação?"],"slap3":["Ai, que tromba boa p'ra levar chapadões!","Já percebi. Agora dá espaço."],"bystander_laugh":["A dignidade foi dar uma volta.","Foi ensaio. Espero eu."],"run_past":["A pressa vai à frente!","Levas a pausa contigo?"],"jump":["O chão ficou ofendido.","Isso conta como escadas?"],"sit_beside":["Senta. Não cobro conversa.","Cabe aqui mais um silêncio."],"gesture_rude":["A legenda ficou em manutenção.","Ó seu #%&@! Bip preventivo."],"golden":["Até a pressa ficou dourada.","Esta luz merece uma pausa."],"sunny":["A sombra chegou primeiro.","O sol está muito disponível."],"storm":["O céu bateu a porta.","O toldo pediu transferência."],"rainbow":["O céu abriu a caixa.","Trouxe todas as cores hoje."],"night":["Agora ouve-se melhor o silêncio.","Há luz para ficar mais pouco."],"talk":["Cheguei cedo à pausa.","A pressa passa. Eu fico."],"human":["Tenho tempo. Conta lá.","Obrigado por ficares um bocadinho."]},"humanMoment":"Tenho tempo. Conta lá.","legacyLinesSource":"spaces/npcs.js SPECS.tortoise.lines (unchanged by patch)"}
